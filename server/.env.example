# Server
NODE_ENV=development
PORT=5000

# MongoDB (get free cluster at https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/futura-labs-ai-tutor-lms?retryWrites=true&w=majority&appName=Cluster0

# JWT
JWT_SECRET=your-secure-random-string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-secure-random-string
JWT_REFRESH_EXPIRE=30d

# Redis (optional - app works without it)
REDIS_URL=redis://localhost:6379

# Cloudinary (optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@futuralabs.com
FROM_NAME=Futura Labs Ai Tutor LMS

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Claude AI (primary - get key at https://console.anthropic.com)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OpenAI (fallback - get key at https://platform.openai.com)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads
